# SecureCipher Backend Environment Configuration Template
PROJECT_NAME="SecureCipher"
VERSION="0.1.0"
API_V1_STR="/api"
PORT=8000
HOST="127.0.0.1"
ENVIRONMENT="development"  # development | staging | production

# CORS configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Configuration (SQLAlchemy 2.x + Psycopg 3)
# Format: postgresql+psycopg://username:password@localhost:5432/database_name
# Note: If password contains special characters (e.g. '@'), URL-encode them (e.g. '%40').
DATABASE_URL="postgresql+psycopg://your_db_user:your_db_password@localhost:5432/securecipher_db"

# JWT Authentication Secret Key (Minimum 32 characters; generate a strong random secret in production)
JWT_SECRET_KEY="generate-at-least-32-random-bytes-for-production-signing"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Verification Configuration (Optional; required for live email dispatch)
# In production, SMTP must be configured to enable account registration.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-notification-email@gmail.com"
SMTP_PASSWORD="your-secure-app-password"
SMTP_FROM_EMAIL="your-notification-email@gmail.com"
SMTP_FROM_NAME="SecureCipher Security Team"
SMTP_TLS=true

# Project Demonstration Mode (Optional - default: false)
# When set to true, allows registration to issue an explicitly marked demo verification code
# without requiring an integrated SMTP email service.
# For production public registration with real users, keep this set to false and configure SMTP.
DEMO_OTP_ENABLED=false
