# SecureCipher Backend Environment Configuration
PROJECT_NAME="SecureCipher"
API_V1_STR="/api"
PORT=8000
HOST="127.0.0.1"

# CORS configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Configuration (SQLAlchemy 2.x + Psycopg 3)
# Replace 'your_password_here' with the actual password for securecipher_user.
# Note: If your password contains special characters like '@', URL-encode them (e.g. '@' -> '%40').
DATABASE_URL="postgresql+psycopg://securecipher_user:your_password_here@localhost:5432/securecipher_db"
